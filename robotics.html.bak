<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description" content="Robotics and Mechatronics portfolio of Ayotunde Omotoso.">

  <title>Robotics — Ayotunde Omotoso</title>

  <style>
    :root[data-theme="dark"] {
      --bg: #0d1117;
      --surface: #161b22;
      --border: #30363d;
      --text: #e6edf3;
      --muted: #8b949e;
      --accent: #58a6ff;
    }

    :root[data-theme="light"] {
      --bg: #ffffff;
      --surface: #f6f8fa;
      --border: #d0d7de;
      --text: #1f2328;
      --muted: #656d76;
      --accent: #0969da;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont,
        "Segoe UI", Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      min-height: 100vh;
      transition: background 0.2s, color 0.2s;
    }

    a {
      color: var(--accent);
      text-decoration: none;
    }

    a:hover {
      text-decoration: underline;
    }

    /* Header */

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1.25rem 2rem;
      border-bottom: 1px solid var(--border);
    }

    .logo {
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--text);
    }

    header nav {
      display: flex;
      gap: 1.5rem;
      flex-wrap: wrap;
      font-size: 0.9rem;
    }

    header nav a {
      color: var(--muted);
    }

    header nav a:hover {
      color: var(--text);
      text-decoration: none;
    }

    /* Main Layout */

    main {
      max-width: 760px;
      margin: 0 auto;
      padding: 4rem 2rem;
    }

    section {
      margin-bottom: 4rem;
    }

    h1 {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    h2 {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 1.5rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    p {
      color: var(--muted);
      max-width: 560px;
    }

    /* Theme Toggle */

    #toggle {
      background: none;
      border: 1px solid var(--border);
      color: var(--muted);
      border-radius: 6px;
      padding: 0.35rem 0.75rem;
      font-size: 0.85rem;
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
    }

    #toggle:hover {
      border-color: var(--accent);
      color: var(--text);
    }

    /* Back Link */

    .back {
      margin-bottom: 2rem;
      display: inline-block;
      font-size: 0.9rem;
      color: var(--muted);
    }

    .back:hover {
      color: var(--accent);
    }

    /* Hero */

    .hero {
      padding-top: 0;
    }

    .hero h1 {
      margin-bottom: 0.5rem;
    }

    .hero .tagline {
      font-size: 1rem;
      color: var(--muted);
      margin-bottom: 1.5rem;
    }

    /* Project Cards */

    .projects {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .card {
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 1.25rem 1.5rem;
      background: var(--surface);
      transition: border-color 0.15s;
    }

    .card:hover {
      border-color: var(--accent);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
    }

    .card-title {
      font-size: 1rem;
      font-weight: 600;
      margin-bottom: 0.35rem;
      color: var(--text);
    }

    .card-title a {
      color: var(--text);
    }

    .card-title a:hover {
      color: var(--accent);
      text-decoration: none;
    }

    .card-desc {
      font-size: 0.9rem;
      color: var(--muted);
      margin-bottom: 0.9rem;
    }

    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    .tag {
      font-size: 0.75rem;
      padding: 0.15rem 0.55rem;
      border-radius: 20px;
      border: 1px solid var(--border);
      color: var(--muted);
    }

    /* Skills */

    .skills-grid {
      display: grid;
      grid-template-columns: repeat(
        auto-fill, minmax(160px, 1fr)
      );
      gap: 0.75rem;
    }

    .skill-group {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.9rem 1rem;
    }

    .skill-group .label {
      font-size: 0.75rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 0.4rem;
    }

    .skill-group .items {
      font-size: 0.9rem;
      color: var(--text);
    }

    /* Footer */

    footer {
      text-align: center;
      padding: 2rem;
      font-size: 0.8rem;
      color: var(--muted);
      border-top: 1px solid var(--border);
    }

    /* Mobile */

    @media (max-width: 700px) {
      header {
        flex-wrap: wrap;
        padding: 1rem;
      }

      header nav {
        gap: 0.8rem;
      }

      main {
        padding: 2.5rem 1.25rem;
      }

      h1 {
        font-size: 1.7rem;
      }
    }
  </style>
</head>

<body>

  <!-- Header -->

  <header>
    <a class="logo" href="index.html">
      Ayotunde Omotoso
    </a>

    <nav aria-label="Main navigation">
      <a href="index.html">Home</a>
      <a href="#projects">Projects</a>
      <a href="data-science.html">Data Science</a>
      <a href="automotive.html">Automotive</a>
      <a href="#skills">Skills</a>
      <a href="#contact">Contact</a>
    </nav>

    <button id="toggle" type="button"
      aria-label="Toggle theme">
      Light
    </button>
  </header>

  <main>

    <!-- Back to Homepage -->

    <a class="back" href="index.html">
      &larr; Home
    </a>

    <!-- Hero -->

    <section class="hero">

      <h1>Robotics &amp; Mechatronics</h1>

      <p class="tagline">
        Exploring the integration of mechanical
        systems, electronics, programming, and
        intelligent control through robotics
        and mechatronics engineering.
      </p>

    </section>

    <!-- Projects -->

    <section id="projects">

      <h2>Projects</h2>

      <div class="projects">

        <div class="card">
          <div class="card-header">
            <div>

              <div class="card-title">
                Robotics &amp; Mechatronics Projects
              </div>

              <p class="card-desc">
                This section is being prepared to
                showcase robotics, embedded systems,
                automation, and mechatronics projects,
                including their design, implementation,
                testing, and technical documentation.
              </p>

            </div>
          </div>

          <div class="tags">
            <span class="tag">Robotics</span>
            <span class="tag">Mechatronics</span>
            <span class="tag">Automation</span>
            <span class="tag">Control Systems</span>
          </div>
        </div>

      </div>
    </section>

    <!-- Skills -->

    <section id="skills">

      <h2>Skills &amp; Tools</h2>

      <div class="skills-grid">

        <!-- Programming -->

        <div class="skill-group">
          <div class="label">
            Programming
          </div>
          <div class="items">
            Python · C++ · Java · MATLAB ·
            OpenCV
          </div>
        </div>

        <!-- Microcontrollers -->

        <div class="skill-group">
          <div class="label">
            Microcontrollers
          </div>
          <div class="items">
            Arduino · Raspberry Pi ·
            Embedded Systems
          </div>
        </div>

        <!-- Control Systems -->

        <div class="skill-group">
          <div class="label">
            Control Systems
          </div>
          <div class="items">
            PID Control · Motor Control ·
            Stepper Motors · BLDC Motors ·
            System Integration
          </div>
        </div>

        <!-- Electronics -->

        <div class="skill-group">
          <div class="label">
            Electronics &amp; Sensors
          </div>
          <div class="items">
            PCB Design · KiCad · Soldering ·
            Wiring Schematics · Ultrasonic Sensors ·
            Force Sensors · Color Sensors ·
            Temperature Sensors
          </div>
        </div>

        <!-- Mechanical Design -->

        <div class="skill-group">
          <div class="label">
            Mechanical Design
          </div>
          <div class="items">
            SolidWorks · AutoCAD ·
            Mechanical Assembly ·
            Rapid Prototyping ·
            3D Printing · Laser Cutting
          </div>
        </div>

        <!-- Robotics -->

        <div class="skill-group">
          <div class="label">
            Robotics &amp; Automation
          </div>
          <div class="items">
            Mechatronic Systems ·
            Sensor Integration ·
            Electromechanical Systems ·
            Automation ·
            Computer Vision
          </div>
        </div>

        <!-- Development Tools -->

        <div class="skill-group">
          <div class="label">
            Development Tools
          </div>
          <div class="items">
            Git · GitHub · GitLab ·
            Jupyter Notebook ·
            Technical Documentation
          </div>
        </div>

      </div>
    </section>

    <!-- Contact -->

    <section id="contact">

      <h2>Contact</h2>

      <p>
        Open to opportunities in robotics,
        mechatronics, automation, embedded systems,
        and related engineering fields.
        Reach out via
        <a href="mailto:ayozille13@gmail.com">
          email
        </a>
        or
        <a href="https://github.com/Tundeeeeee"
          target="_blank"
          rel="noopener noreferrer">
          GitHub
        </a>.
      </p>

    </section>

  </main>

  <!-- Footer -->

  <footer>
    &copy; 2026 Ayotunde Omotoso
  </footer>

  <!-- Dark / Light Theme Script -->

  <script>
    const toggle = document.getElementById("toggle");
    const root = document.documentElement;

    let saved = "dark";

    try {
      saved = localStorage.getItem("theme") || "dark";
    } catch (error) {
      saved = "dark";
    }

    if (saved !== "dark" && saved !== "light") {
      saved = "dark";
    }

    root.setAttribute("data-theme", saved);

    toggle.textContent =
      saved === "dark" ? "Light" : "Dark";

    toggle.addEventListener("click", () => {
      const next =
        root.getAttribute("data-theme") === "dark"
          ? "light"
          : "dark";

      root.setAttribute("data-theme", next);

      toggle.textContent =
        next === "dark" ? "Light" : "Dark";

      try {
        localStorage.setItem("theme", next);
      } catch (error) {
        // The theme still changes without storage.
      }
    });
  </script>

</body>
</html>
